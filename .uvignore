# uv ignore file - speeds up uv operations
# Similar to .gitignore but for uv package operations

# Build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Documentation
docs/_build/

# Temporary files
*.tmp
*.log
.cache/
